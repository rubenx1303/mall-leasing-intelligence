# Copiar a .env y ajustar. Nunca subir .env al repositorio.
# Base de datos local de desarrollo (docker compose). Usuario de solo lectura para la API.
DATABASE_URL=postgres://mli_app:mli_app_dev@localhost:54330/mli
# Usuario propietario, solo para crear el esquema y cargar la semilla
DATABASE_ADMIN_URL=postgres://mli_owner:mli_owner_dev@localhost:54330/mli
API_PORT=8787
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173
